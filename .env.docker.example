# AI Agent Failure Memory — Docker Compose environment overrides.
#
# Copy to .env and edit:
#   cp .env.docker.example .env
#
# Compose reads .env automatically for ${...} interpolation in compose.yaml.
# All values are optional; the defaults run fully offline. Never commit .env.

# --------------------------------------------------------------------------- #
# Ports (host side)
# --------------------------------------------------------------------------- #
BACKEND_PORT=8000
FRONTEND_PORT=3000
# NOTE: the browser-facing API URL (http://localhost:$BACKEND_PORT) is baked
# into the frontend image at build time. After changing BACKEND_PORT run:
#   docker compose build frontend    (or just: docker compose up --build)

# --------------------------------------------------------------------------- #
# Backend (container)
# --------------------------------------------------------------------------- #
APP_ENV=production
LLM_PROVIDER=ollama
LLM_MODEL=qwen:4b
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=
LLM_NUM_THREADS=0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0
# LLM_SEED=7
# LLM_CONTEXT_LENGTH=8192
# Reasoning models (qwen3.5 "thinking" and friends): 1 skips hidden reasoning.
LLM_DISABLE_THINKING=0
# LLM benchmark reports land on the persistent volume by default; the value
# below equals the compose.yaml default and needs no change.
LLM_BENCHMARK_OUTPUT_DIR=/app/data/llm_benchmarks
EMBEDDING_PROVIDER=hashing
RETRIEVAL_METHOD=auto

# API access control (recommended for anything beyond one trusted user on one
# machine). Generate a token with `openssl rand -hex 32` and paste it here:
#
#   API_AUTH_TOKEN=
#
# When set, task-run and memory-mutation endpoints require it, and the
# frontend image must be (re)built so the dashboard bundle carries the same
# value (compose passes it through as NEXT_PUBLIC_API_TOKEN). Leaving it
# empty disables enforcement. See the README "API security" section.

# Maximum accepted HTTP request-body size in bytes (oversized -> HTTP 413).
MAX_REQUEST_BODY_BYTES=262144

# Additional backend knobs (CORS_ORIGINS, RETRIEVAL_*, WEIGHT_*, ...) are
# configured in compose.yaml under services.backend.environment — add entries
# there if you need to override them in containers.
