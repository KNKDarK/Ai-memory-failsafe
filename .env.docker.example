# AI Agent Failure Memory — Docker Compose environment overrides.
#
# Copy to .env and edit:
#   cp .env.docker.example .env
#
# Compose reads .env automatically for ${...} interpolation in compose.yaml.
# All values are optional; the defaults run fully offline. Never commit .env.

# --------------------------------------------------------------------------- #
# Ports (host side)
# --------------------------------------------------------------------------- #
BACKEND_PORT=8000
FRONTEND_PORT=3000
# NOTE: the browser-facing API URL (http://localhost:$BACKEND_PORT) is baked
# into the frontend image at build time. After changing BACKEND_PORT run:
#   docker compose build frontend    (or just: docker compose up --build)

# --------------------------------------------------------------------------- #
# Backend (container)
# --------------------------------------------------------------------------- #
APP_ENV=production
LLM_PROVIDER=ollama
LLM_MODEL=qwen:4b
LLM_BASE_URL=http://host.docker.internal:11434
LLM_API_KEY=
LLM_NUM_THREADS=0
EMBEDDING_PROVIDER=hashing
RETRIEVAL_METHOD=auto
# Additional backend knobs (CORS_ORIGINS, RETRIEVAL_*, WEIGHT_*, ...) are
# configured in compose.yaml under services.backend.environment — add entries
# there if you need to override them in containers.
