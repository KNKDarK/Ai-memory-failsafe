# AI Agent Failure Memory — example configuration.
#
# Copy to `.env` and edit. Every value below is OPTIONAL: the project runs
# fully offline and deterministically with the defaults shown. No API key, GPU,
# or network access is required.
#
#   cp .env.example .env
#
# Never commit the real `.env` file or any secret.

# --------------------------------------------------------------------------- #
# Backend
# --------------------------------------------------------------------------- #

# Where the SQLite failure-memory database lives. Use ":memory:" for ephemeral.
MEMORY_DATABASE=data/memory.db

# Where the evaluation benchmark writes its machine-readable JSON report.
EVALUATION_REPORT_PATH=data/evaluation_report.json

APP_ENV=development

# Comma-separated list of origins allowed to call the API (the Next.js frontend).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --------------------------------------------------------------------------- #
# LLM provider (optional)
# --------------------------------------------------------------------------- #
# "deterministic" (default), "llama.cpp" (local llama-server), "ollama"
# (local daemon), or "openai" (any OpenAI-compatible endpoint; requires a key).
# The LLM evaluation benchmark needs a real provider; everything else — the
# deterministic benchmark, the API, and the full test suite — runs offline.
LLM_PROVIDER=deterministic
LLM_MODEL=deterministic-rule-based
# llama-server example: http://127.0.0.1:8080  (a trailing "/v1" is tolerated)
LLM_BASE_URL=https://api.openai.com/v1
# Only needed when the model server requires it (llama-server --api-key).
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
# 0 automatically uses all host CPU cores for Ollama's CPU work.
LLM_NUM_THREADS=0
# Generation settings for real-model runs (conservative small-model defaults).
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0
# LLM_SEED=7                      # optional; improves comparability
# LLM_CONTEXT_LENGTH=8192         # optional server context override
# Reasoning models (qwen3.5 "thinking" and friends): set to 1 to skip the
# hidden reasoning phase — small models otherwise return empty answers.
LLM_DISABLE_THINKING=0
# Where LLM benchmark reports are written (unique run ids; never overwritten).
LLM_BENCHMARK_OUTPUT_DIR=data/llm_benchmarks

# --------------------------------------------------------------------------- #
# Embedding / retrieval
# --------------------------------------------------------------------------- #
# Embedding provider: "hashing" (default, offline, deterministic feature hashing)
# is a LEXICAL similarity, not a trained semantic model. "tfidf" is a pure
# lexical fallback. "openai" enables optional neural embeddings when a key is set.
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIM=256
EMBEDDING_MODEL=text-embedding-3-small

# Ranking knobs. The two floors (min_score and min_similarity) must BOTH be
# cleared before a memory is selected, so a confident but textually unrelated
# memory can never be injected on confidence/recency alone.
RETRIEVAL_LIMIT=5
RETRIEVAL_MIN_SCORE=0.28
RETRIEVAL_MIN_SIMILARITY=0.08

# Text-similarity method used to score candidates. "auto" (default) keeps the
# historical behaviour: the configured embedder when available, otherwise TF-IDF.
# Set explicitly to one of: tfidf | bm25 | embedding | hybrid. BM25 and TF-IDF
# are lexical; "hybrid" is 0.5 embedding + 0.5 BM25. A lexical method is always
# reported as lexical (never as "semantic").
RETRIEVAL_METHOD=auto

WEIGHT_SIMILARITY=0.62
WEIGHT_CONFIDENCE=0.20
WEIGHT_RECENCY=0.10
WEIGHT_FEEDBACK=0.08
RECENCY_HALF_LIFE_DAYS=30

# A memory must reach this effective confidence before its prevention may change
# the agent's plan.
MIN_CONFIDENCE_TO_APPLY=0.55

# --------------------------------------------------------------------------- #
# Memory lifecycle (deterministic; preview is a dry run, apply writes)
# --------------------------------------------------------------------------- #
# A memory untouched for this many days is labelled "stale".
LIFECYCLE_STALE_AFTER_DAYS=30
# Past this age (or once archived) a memory is labelled "expired".
LIFECYCLE_RETIRE_AFTER_DAYS=90
# A memory applied at least MIN_USES times with a failure ratio above this is
# labelled "obsolete".
LIFECYCLE_OBSOLETE_FAILURE_RATIO=0.5
LIFECYCLE_MIN_USES_FOR_OBSOLETE=3

# --------------------------------------------------------------------------- #
# Agent execution
# --------------------------------------------------------------------------- #
DEFAULT_MAX_ATTEMPTS=2
MAX_RETRIES_PER_STEP=1

# --------------------------------------------------------------------------- #
# Security / privacy
# --------------------------------------------------------------------------- #
# Redact secrets (tokens, keys, Authorization headers) from all API responses.
REDACT_SECRETS=true
MAX_MEMORY_TEXT_LENGTH=4000

# API access control (single-user local deployments). When set, task-run and
# memory-mutation endpoints require the token via
# `Authorization: Bearer <token>` or `X-API-Key: <token>` (401 without, 403
# with a wrong token). Health, config, listings, and retrieval preview stay
# open. Leave empty to disable enforcement (open development mode).
# Generate one with:  openssl rand -hex 32
# Rotation: set a new value and restart the backend (and rebuild the frontend
# in Docker — see README "API security").
API_AUTH_TOKEN=

# Maximum accepted HTTP request-body size in bytes. Oversized requests are
# rejected with HTTP 413, for every content type (JSON, multipart, chunked).
MAX_REQUEST_BODY_BYTES=262144

# Limits for user-supplied nested environment/config structures (HTTP 422):
# nesting depth, entries per mapping/list, and string value length.
MAX_ENV_DEPTH=6
MAX_ENV_ITEMS=64
MAX_ENV_VALUE_LENGTH=4096

# --------------------------------------------------------------------------- #
# Frontend
# --------------------------------------------------------------------------- #
# Base URL of the backend API used by the browser. Rebuild the frontend after
# changing a NEXT_PUBLIC_* variable (it is inlined at build time).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
