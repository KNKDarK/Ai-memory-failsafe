# AI Agent Failure Memory — dashboard UI example configuration.
#
# Copy to `.env.local` (git-ignored) and adjust the port if needed:
#
#   cp .env.example .env.local
#
# `.env.local` is git-ignored. It normally only points the browser at the
# local backend. If you enable the backend's API access control, you may also
# put the local API token below — keep the file private and never commit it.

# Base URL of the FastAPI backend the dashboard calls.
# The committed default (see lib/api.ts) is http://localhost:8000, which matches
# the port documented in the main README and docker-compose.
#
# If 8000 is already taken on your machine, launch the backend on 8001 instead
# and point this value at it:
#   uvicorn backend.app:app --port 8001 --reload
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: the backend's API access token (see README "API security"). Only
# needed when the backend is started with API_AUTH_TOKEN set; leave empty
# otherwise. Inlined into the bundle at build time (rebuild after changes).
# NEXT_PUBLIC_API_TOKEN=
